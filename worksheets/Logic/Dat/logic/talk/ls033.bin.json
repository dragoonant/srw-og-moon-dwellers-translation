   "id": 280,
   "en": "Al, for now we're getting out of here,@right?",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 281,
   "en": "...Yeah. I'll take the rear. You go on ahead.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 282,
   "en": "Roger!",
   "kind": "text",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 283,
   "en": "Anyone who tries to lay a hand on it dies.@All units, attack.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 284,
   "en": "Al, why aren't you moving?!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
