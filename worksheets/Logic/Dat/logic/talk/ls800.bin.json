   "id": 87,
   "en": "Arado",
   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 88,
   "en": "The mess hall, duh! It's Friday,@which means Steel Dragon Curry Day!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 89,
   "en": "Latune",
   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 90,
   "en": "No need to rush. I'm sure there's enough@for everyone...",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 91,
   "en": "No, no, I wanna be first in line@so they give me extra meat!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 92,
   "en": "Honestly... He's not a kid anymore.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 93,
   "en": "Bullet",
   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 94,
   "en": "The endlessly expanding universe...@The comrades who fight alongside us.@And you.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 95,
