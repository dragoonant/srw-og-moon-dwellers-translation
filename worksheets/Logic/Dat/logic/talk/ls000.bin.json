   "keep": true
  },
  {
   "id": 246,
   "en": "...You're quick to respond, Al-Van.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 247,
   "en": "",
   "kind": "ascii",
