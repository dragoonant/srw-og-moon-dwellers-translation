   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 271,
   "en": "What's this? The moment they showed up...",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 272,
   "en": "Hey, hey, aren't they combining@faster than usual?",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 273,
   "en": "Are the Lamaris getting more sensitive...?!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 274,
   "en": "But we ain't at full strength right now.",
