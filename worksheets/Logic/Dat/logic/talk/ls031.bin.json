   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 310,
   "en": "L-L-L-Lord Dark Braiiiiin...!!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 311,
   "en": "All right, we got him!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 312,
   "en": "In the end, we never found out@what Debudedabide was after...",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 313,
   "en": "Kota, Shoko. This isn't over yet.",
