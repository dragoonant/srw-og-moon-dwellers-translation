   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 243,
   "en": "Azuki",
   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 244,
   "en": "XO, do you have a moment?",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 245,
   "en": "Tetsuya",
   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 246,
   "en": "What's that?",
   "kind": "text",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 247,
   "en": "I intercepted transmissions from the Cross Gate@Watch Fleet, but something seems wrong...@It sounds like PT platoons are fighting each other.",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
   "id": 248,
   "en": "Fighting...?",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
