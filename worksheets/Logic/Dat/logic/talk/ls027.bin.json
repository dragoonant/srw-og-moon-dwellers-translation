   "kind": "name",
   "keep": false,
   "en_src": "tm"
  },
  {
   "id": 270,
   "en": "No enemy signals left in the battle zone!@All Lamaris eliminated!",
   "kind": "text",
   "keep": false,
   "en_src": "ai"
  },
  {
